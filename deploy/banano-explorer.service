# Banano Explorer: one Go binary that talks only to the local Banano node.
[Unit]
Description=Banano Explorer
After=network-online.target docker.service
Wants=network-online.target

[Service]
ExecStart=/usr/local/bin/banano-explorer \
  -listen 127.0.0.1:9990 \
  -node http://[::1]:7072 \
  -ws ws://[::1]:7079 \
  -state /var/lib/banano-explorer \
  -public-url https://explorer.banano.trade
Restart=always
RestartSec=2

# Throwaway unprivileged user; it can only write its own state directory.
DynamicUser=yes
StateDirectory=banano-explorer
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
UMask=0077
LimitNOFILE=65536
MemoryMax=1G

[Install]
WantedBy=multi-user.target
